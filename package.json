{
  "name": "zeiterfassung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "security": "npm audit --audit-level=high && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node scripts/test-rls-cloud.mjs",
    "test:rls:local": "vitest run --config vitest.rls.config.ts",
    "seed:passwords": "node scripts/seed-passwords.mjs",
    "typecheck": "tsc --build --force",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > web/src/lib/database.types.ts",
    "functions:deploy": "supabase functions deploy admin-users --use-api",
    "emails": "node scripts/email-templates.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
