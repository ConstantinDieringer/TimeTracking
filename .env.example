# Supabase — Werte im Dashboard unter Project Settings > API (Project URL und
# der „anon“-Schlüssel). Der anon-Schlüssel ist öffentlich und landet ohnehin
# im Browser-Bündel; geschützt wird über Row Level Security.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Nur serverseitig (Edge Function). Gehört niemals in eine VITE_-Variable,
# weil alles mit diesem Präfix ins Browser-Bundle wandert.
# SUPABASE_SERVICE_ROLE_KEY=
