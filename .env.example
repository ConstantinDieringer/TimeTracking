# Supabase — lokal liefert `supabase start` diese Werte im Terminal aus.
# Für die Produktion stehen sie im Dashboard unter Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=

# Nur serverseitig (Edge Function). Gehört niemals in eine VITE_-Variable,
# weil alles mit diesem Präfix ins Browser-Bundle wandert.
# SUPABASE_SERVICE_ROLE_KEY=
